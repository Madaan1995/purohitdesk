# Every environment variable the app reads, without values.

# Set by Vercel on every deployment; do not set it yourself.
# GET /api/v1/healthz returns "unknown" when it is absent (local runs).
# VERCEL_GIT_COMMIT_SHA=

# Supabase project URL, e.g. https://<project-ref>.supabase.co (JWT issuer and JWKS are derived from it). (M2)
NEXT_PUBLIC_SUPABASE_URL=
# Supabase publishable key (sb_publishable_…); used only for the Google sign-in flow. (M2)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only. app_runtime login through Supavisor's transaction pooler (port 6543); see supabase/ops/runbook.md. (M2)
DATABASE_URL=

# SQL test harness and integration tests only (npm run test:db, npm run test:integration):
# a THROWAWAY Postgres superuser connection, never a real database.
# PGHOST=localhost
# PGPORT=5432
# PGUSER=postgres
# PGPASSWORD=
# PGDATABASE=pd_test

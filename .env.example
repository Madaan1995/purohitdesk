# Every environment variable the app reads, without values.

# Set by Vercel on every deployment; do not set it yourself.
# GET /api/v1/healthz returns "unknown" when it is absent (local runs).
# VERCEL_GIT_COMMIT_SHA=

# SQL test harness only (npm run test:db): a THROWAWAY Postgres superuser connection, never a real database.
# PGHOST=localhost
# PGPORT=5432
# PGUSER=postgres
# PGPASSWORD=
